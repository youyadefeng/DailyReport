# Copy this file to .env.local and fill in only one provider.

# OpenAI translation provider
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# MiniMax translation provider
MINIMAX_API_KEY=
MINIMAX_TRANSLATION_MODEL=MiniMax-M2.5
# International users: https://api.minimax.io/v1
# China mainland users: https://api.minimaxi.com/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1
